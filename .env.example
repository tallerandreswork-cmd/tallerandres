# =========================================================================
# CONFIGURACIÓN DE SUPABASE (PRODUCCIÓN / DESARROLLO)
# =========================================================================
# Obtén estas credenciales en tu panel de Supabase:
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# =========================================================================
# CLAVES PRIVADAS DE SERVIDOR (PRODUCCIÓN - NUNCA EXPUESTAS AL NAVEGADOR)
# =========================================================================
# En Next.js, cualquier variable SIN el prefijo NEXT_PUBLIC_ vive únicamente en el
# servidor (Node.js). CERO líneas de esta contraseña llegan al navegador del cliente.
ADMIN_PASSWORD=MiClaveSuperSeguraAdmin2026
MECHANIC_PASSWORD=ClaveSeguraMecanicos2026
